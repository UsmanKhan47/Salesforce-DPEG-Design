# Salesforce CLI local state (contains org auth + source tracking — never commit)
.sf/
.sfdx/
.localdevserver/
deploy-options.json
*.dmp

# Logs
*.log

# Node
node_modules/
npm-debug.log*

# LWC Jest coverage output (generated by `npm run test:unit:coverage`)
coverage/

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Local backups / exports (not source)
backup/
backup-0615/
data-backup/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Subagent local memory (machine-specific, per agent definition: memory: local)
# The `**/` form is required: a pattern containing a slash is anchored to this
# directory, so the bare `.claude/agent-memory-local/` below never matched the
# copies agents wrote under force-app/ (2026-08-05).
**/.claude/agent-memory-local/
.claude/agent-memory-local/

# Agent-local memory written into package dirs by subagents — never deploy, never commit
force-app/**/.claude/

# Client documentation — FSDs, MoMs, checklists and generated build docs.
# Added 2026-08-27 at the user's request: this folder holds DPEG-confidential
# material and must not travel to the remote.
#
# ⚠ .gitignore only prevents FUTURE tracking. The 17 client documents under
# docs/ have been in this repository since the initial commit (7d1a561) and
# REMAIN IN GIT HISTORY on the remote after this change. Removing them from
# HEAD is not the same as purging them — that needs a history rewrite
# (git filter-repo / BFG) plus a force push, and a request to GitHub Support
# to drop cached unreachable objects. Any existing clone or fork keeps them.
docs/
