# Salesforce CLI local state (contains org auth + source tracking — never commit)
.sf/
.sfdx/
.localdevserver/
deploy-options.json
*.dmp

# Logs
*.log

# Node
node_modules/
npm-debug.log*

# LWC Jest coverage output (generated by `npm run test:unit:coverage`)
coverage/

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Local backups / exports (not source)
backup/
backup-0615/
data-backup/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Subagent local memory (machine-specific, per agent definition: memory: local)
# The `**/` form is required: a pattern containing a slash is anchored to this
# directory, so the bare `.claude/agent-memory-local/` below never matched the
# copies agents wrote under force-app/ (2026-08-05).
**/.claude/agent-memory-local/
.claude/agent-memory-local/
