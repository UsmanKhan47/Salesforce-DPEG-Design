<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Notify_Counter</name>
        <label>Notify Counter</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <actionName>GroupNotifier</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recipientGroup</name>
            <value><stringValue>Acquisitions_Team</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value><elementReference>fTitle</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value><elementReference>fBody</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>targetRecordId</name>
            <value><elementReference>$Record.LOI__c</elementReference></value>
        </inputParameters>
        <nameSegment>GroupNotifier</nameSegment>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <environments>Default</environments>
    <formulas>
        <name>fTitle</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Direction__c}, 'Seller'),
'LOI counter received - ball in our court',
'LOI counter sent to seller')</expression>
    </formulas>
    <formulas>
        <name>fBody</name>
        <dataType>String</dataType>
        <expression>'Counter price: ' &amp; IF(ISBLANK({!$Record.Counter_Price__c}), 'n/a', TEXT({!$Record.Counter_Price__c}))</expression>
    </formulas>
    <interviewLabel>Counter Offer Notify {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Counter Offer Notify</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Notify_Counter</targetReference></connector>
        <object>Counter_Offer__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
