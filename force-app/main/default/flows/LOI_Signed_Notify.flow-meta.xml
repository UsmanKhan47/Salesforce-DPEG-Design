        </inputParameters>
        <inputParameters>
            <name>targetRecordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>GroupNotifier</nameSegment>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <environments>Default</environments>
    <interviewLabel>LOI Signed Notify {!$Flow.CurrentDateTime}</interviewLabel>
