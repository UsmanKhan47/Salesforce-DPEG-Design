<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Investor_Welcome_Email</name>
        <label>Send Investor Welcome Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <description>Sends the Investor Welcome Lightning email template to the new Contact and logs it on the Contact&apos;s activity timeline. Deliberately does NOT set relatedRecordId (WhatId) -- WhatId only accepts &quot;What&quot; entities (Account, Opportunity, Case, Campaign, custom objects), never a &quot;Who&quot; entity like Contact. This action runs off a Contact record, so binding relatedRecordId to $Record.Id fails at runtime with &quot;Invalid entity type for whatId.&quot; recipientId plus logEmailOnSend=true alone are sufficient to log the email on the Contact&apos;s activity timeline. Do not re-add relatedRecordId here.</description>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailTemplateId</name>
            <value>
                <elementReference>rec_EmailTemplate.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>logEmailOnSend</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <decisions>
        <name>Decision_Ready_To_Send</name>
        <label>Template Found and Email Present?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Template Missing or No Email</defaultConnectorLabel>
        <description>Confirms the Investor Welcome Email template was found and the Contact has an email address before attempting to send the welcome email.</description>
        <rules>
            <name>Ready_To_Send</name>
            <conditionLogic>1 AND 2</conditionLogic>
            <conditions>
                <leftValueReference>rec_EmailTemplate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Investor_Welcome_Email</targetReference>
            </connector>
            <label>Template Found and Email Present</label>
        </rules>
    </decisions>
    <description>Sends the Investor Welcome Lightning email to a newly created Investor-record-type Contact and logs it on the Contact&apos;s activity timeline.</description>
    <environments>Default</environments>
    <interviewLabel>Investor Welcome Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Investor Welcome Flow</label>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Investor_Welcome_Email_Template</name>
        <label>Get Investor Welcome Email Template</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Ready_To_Send</targetReference>
        </connector>
        <description>Looks up the Investor Welcome Email Lightning email template by its developer name so the send-email step can reference it by Id.</description>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Investor_Welcome_Email</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>EmailTemplate</object>
        <outputReference>rec_EmailTemplate</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Investor_Welcome_Email_Template</targetReference>
        </connector>
        <filterFormula>{!$Record.RecordType.DeveloperName} = &apos;Investor&apos;</filterFormula>
        <object>Contact</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>rec_EmailTemplate</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>EmailTemplate</objectType>
    </variables>
</Flow>
