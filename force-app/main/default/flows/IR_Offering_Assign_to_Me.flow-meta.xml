    <apiVersion>67.0</apiVersion>
    <description>Assigns the Offering identified by the recordId input to the current running user (OwnerId = $User.Id), then shows a success confirmation screen. Launched by the Offering__c.Assign_to_Me quick action, visible only when the Offering is currently queue-owned (Is_Owner_Queue__c = true). No fault path and no queue-membership check by design - see header comment.</description>
    <environments>Default</environments>
    <interviewLabel>IR-Offering-Assign-to-Me {!$Flow.CurrentDateTime}</interviewLabel>
    <label>IR-Offering-Assign-to-Me</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordUpdates>
        <name>Assign_Offering_to_Me</name>
        <label>Assign Offering to Me</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Screen_Success</targetReference>
        </connector>
        <description>Updates OwnerId on the Offering identified by recordId to the running user's Id. No faultConnector by design - see flow header comment. No queue-membership check by design - see flow header comment.</description>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Offering__c</object>
    </recordUpdates>
    <screens>
        <name>Screen_Success</name>
        <label>Assign to Me</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <description>Terminal success screen. No Previous button (allowBack false) and no outgoing connector, so Finish is the only action.</description>
        <fields>
            <name>Success_Message</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(46, 132, 74); font-size: 48px;&quot;&gt;✓&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Success!&lt;/b&gt; This Offering is now assigned to you.&lt;/span&gt;&lt;/p&gt;</fieldText>
        </fields>
        <nextOrFinishButtonLabel>Finish</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_Offering_to_Me</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
