    <label>Lease Inquiry Open Log</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Opening_Entry</name>
        <label>Create Opening Entry</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <inputAssignments>
            <field>Ball_In_Court__c</field>
