<?xml version="1.0" encoding="UTF-8"?>
<ListView xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
        DISPOSITION GAP CLOSURE TRANCHE 1, ITEM 13. See All_Dispositions.listView-meta.xml in this
        same folder for the shared GATE D-13 collision warning and the column/sharedTo rationale -
        not repeated here. Filter: Disposition_Stage__c not equal 'Sale Closes' - everything short
        of the terminal stage on either record type (Sale Closes is the shared final value on
        both On_Market and Off_Market's Disposition_Stage__c sequences).

        ⚠ S-1 (code review, 2026-08-31): a `notEqual 'Sale Closes'` filter also admits rows where
        Disposition_Stage__c is NULL - a disposition with no stage set yet shows up as "active."
        This is PROBABLY INTENDED (an unstamped disposition is not closed, so it is reasonable for
        it to read as active) and is recorded here deliberately so a future reader does not "fix"
        it by adding an explicit NOT(ISBLANK(...)) clause without first confirming that is wanted.
    -->
    <fullName>Active_Sales</fullName>
    <columns>NAME</columns>
    <columns>Property_Asset__c</columns>
    <columns>Disposition_Stage__c</columns>
    <columns>Selected_Broker__c</columns>
    <columns>Listing_Date__c</columns>
    <columns>Closing_Date__c</columns>
    <columns>LAST_UPDATE</columns>
    <filterScope>Everything</filterScope>
    <filters>
        <field>Disposition_Stage__c</field>
        <operation>notEqual</operation>
        <value>Sale Closes</value>
    </filters>
    <label>Active Sales</label>
</ListView>
