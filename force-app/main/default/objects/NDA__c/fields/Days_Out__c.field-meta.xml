<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Out__c</fullName>
    <description>Days since the NDA was sent (TODAY - Date Sent). Gives the dashboard NDA Tracker table a numeric column and flags aging NDAs.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Date_Sent__c), null, TODAY() - Date_Sent__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Days Out</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
