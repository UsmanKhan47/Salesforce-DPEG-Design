<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EM_Wired__c</fullName>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Earnest_Money__c), &quot;-&quot;,
  IF(Earnest_Money__c &gt;= 1000000,
     &quot;$&quot; &amp; TEXT(ROUND(Earnest_Money__c / 1000000, 2)) &amp; &quot;M&quot;,
     &quot;$&quot; &amp; TEXT(ROUND(Earnest_Money__c / 1000, 0)) &amp; &quot;K&quot;))</formula>
    <label>EM Wired</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
