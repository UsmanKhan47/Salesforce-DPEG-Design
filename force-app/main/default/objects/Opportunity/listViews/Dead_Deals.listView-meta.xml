    <columns>OPPORTUNITY.STAGE_NAME</columns>
    <columns>Deal_Status__c</columns>
    <columns>Asset_Type__c</columns>
    <columns>Rejection_Reason__c</columns>
    <columns>Asking_Price__c</columns>
