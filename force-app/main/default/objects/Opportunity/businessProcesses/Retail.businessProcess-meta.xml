<?xml version="1.0" encoding="UTF-8"?>
<BusinessProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
        THIS NOTE LIVES IN A COMMENT, NOT IN <description>, and it is INSIDE the root
        element on purpose - a comment ABOVE <BusinessProcess> breaks `sf` deploy at
        conversion.

        THIS FILE REPLACES Opportunity/businessProcesses/Commercial.businessProcess-meta.xml.
        It is a clone of that file with the root <fullName> changed. The nine stage values
        and their order are IDENTICAL, deliberately: this rename must not alter which
        stages a commercial deal can occupy. Diff the two files before D4 - there should be
        no difference beyond <fullName>.

        Dead%2FPass IS CORRECTLY ENCODED AND MUST STAY THAT WAY. The runtime value is the
        plain string 'Dead/Pass'; the %2F encoding applies inside BusinessProcess and
        picklist metadata ONLY. Do not "fix" it, and do not apply the same treatment to any
        other value here - none of the others contains a slash.

        PHASE 2 WILL EDIT THIS FILE AGAIN. The PSA -> 'Under Contract (PSA)' rename
        (spec sec 3) touches BOTH business processes, this one and Land. 'Under Contract
        (PSA)' contains spaces and parentheses but NO slash, so no encoding applies to it
        either - the requirements doc calls that out explicitly because the Dead%2FPass
        precedent invites exactly that mistake.
    -->
    <fullName>Retail</fullName>
    <isActive>true</isActive>
    <values>
        <fullName>About to Close</fullName>
        <default>false</default>
    </values>
    <values>
        <fullName>Closed Won</fullName>
        <default>false</default>
    </values>
    <values>
        <fullName>Construction Review</fullName>
        <default>false</default>
    </values>
    <values>
        <fullName>Dead%2FPass</fullName>
        <default>false</default>
    </values>
    <values>
        <fullName>LOI</fullName>
        <default>false</default>
    </values>
    <values>
        <fullName>New</fullName>
        <default>false</default>
    </values>
    <values>
        <fullName>Under Contract (PSA)</fullName>
        <default>false</default>
    </values>
    <values>
        <fullName>Under Review</fullName>
        <default>false</default>
    </values>
    <values>
        <fullName>Underwriting</fullName>
        <default>false</default>
    </values>
</BusinessProcess>
