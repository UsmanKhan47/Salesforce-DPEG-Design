<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Charge_Type__c</fullName>
    <description>Which component of the bill this line represents. FSD 5.10.3 notes that components vary by utility and appear irregularly, which is the reason charges are lines rather than fixed columns. Deliberately UNRESTRICTED, see the comment below.</description>
    <inlineHelpText>Pick the closest match to the wording on the invoice. New component names can be entered when a provider introduces one, so an unfamiliar charge does not have to be forced into Other.</inlineHelpText>
    <label>Charge Type</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>false</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
