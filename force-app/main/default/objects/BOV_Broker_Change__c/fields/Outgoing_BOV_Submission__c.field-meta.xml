<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
        THIS COMMENT SITS INSIDE THE ROOT ELEMENT DELIBERATELY - see Disposition__c.field-meta.xml
        in this folder for why a comment above the root breaks `sf` deploy.

        TWO LOOKUPS TO ONE OBJECT, DISTINCT NAMES (design O-3, accepted). Outgoing_BOV_Submission__c
        and Incoming_BOV_Submission__c both point at BOV_Submission__c; the convention's own
        "API names must be unique" escape applies, same shape as Broker_Assignment__c and
        Disposition__c both needing a role-named Contact lookup rather than a bare Contact__c.

        RELATIONSHIP NAME COLLISION CHECKED ON THE BOV_Submission__c PARENT: no other field in
        this repo references BOV_Submission__c, so Outgoing_Broker_Changes is free. It must also
        stay distinct from Incoming_BOV_Submission__c's relationshipName (Incoming_Broker_Changes)
        - two lookups to the same object cannot share a relationshipName.
    -->
    <fullName>Outgoing_BOV_Submission__c</fullName>
    <deleteConstraint>SetNull</deleteConstraint>
    <description>The BOV Submission for the broker being replaced.</description>
    <inlineHelpText>The BOV response from the broker who is being replaced.</inlineHelpText>
    <label>Outgoing BOV Submission</label>
    <referenceTo>BOV_Submission__c</referenceTo>
    <relationshipLabel>Outgoing Broker Changes</relationshipLabel>
    <relationshipName>Outgoing_Broker_Changes</relationshipName>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Lookup</type>
</CustomField>
