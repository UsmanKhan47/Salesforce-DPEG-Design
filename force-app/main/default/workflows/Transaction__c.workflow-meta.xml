<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Transaction_Opened_Notification</fullName>
        <description>Notifies the Transactions_Team group by email when a new Transaction is opened (Day-0, post-PSA execution) - the moment there is real work. Group recipient so it survives staffing changes.</description>
        <protected>false</protected>
        <recipients>
            <recipient>Transactions_Team</recipient>
            <type>group</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Transaction_Opened_Notification</template>
    </alerts>
</Workflow>
