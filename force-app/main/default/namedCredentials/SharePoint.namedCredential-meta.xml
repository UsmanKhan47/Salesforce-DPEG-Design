<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <calloutStatus>Enabled</calloutStatus>
    <!-- MUST be true — the opposite of OpenAI_API's generateAuthorizationHeader, and deliberately
         so. OpenAI_API sets it false because its External Credential supplies its own custom
         Authorization header via an AuthHeader parameter (Bearer {!$Credential...}); setting it
         true there overrode that header and broke every OpenAI callout (found live 2026-08-01).
         SharePoint_Credential is OAuth 2.0 client-credentials, which carries no custom Authorization
         header of its own — the platform must mint "Authorization: Bearer <token>" from the token it
         obtains via the External Credential's token endpoint, which is exactly what
         generateAuthorizationHeader = true does. Setting this false here would send every
         SharePoint/Graph callout with no Authorization header at all. Same field, opposite correct
         value, for opposite reasons. Do not "harmonize" this with OpenAI_API. -->
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <label>SharePoint</label>
    <namedCredentialParameters>
        <parameterName>Url</parameterName>
        <parameterType>Url</parameterType>
        <parameterValue>https://graph.microsoft.com/v1.0</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <externalCredential>SharePoint_Credential</externalCredential>
        <parameterName>ExternalCredential</parameterName>
        <parameterType>Authentication</parameterType>
    </namedCredentialParameters>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
</NamedCredential>
