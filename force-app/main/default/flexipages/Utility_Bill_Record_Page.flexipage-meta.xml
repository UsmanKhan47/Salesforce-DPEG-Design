    <!--
      NEW PAGE, 2026-08-22. No Utility_Bill_Record_Page previously existed in this repo, so
      Utility_Bill__c has been rendering on the platform default record page with no c:utilityBillDetail
      panel. Structurally cloned from the proven, currently-live Property_Asset_Record_Page
      (header/tabbed-main pattern), which carries the same posture: enableActivities=false on this
      object (see Utility_Bill__c.object-meta.xml), so no sidebar / Activity tab is included, matching
      the precedent set by flexipages/Portfolio_Deal_Record_Page.flexipage-meta.xml for the same
      enableActivities=false case. c:utilityBillDetail declares only @api recordId with no
      targetConfig componentInstanceProperty for it - recordId is auto-injected by the platform for any
      component placed on a lightning__RecordPage, so none is declared here either.
      Reachable via the Property_Management app's View actionOverride for Utility_Bill__c, added in
      the same deploy that created this file (applications/Property_Management.app-meta.xml) - a
      FlexiPage alone is inert without an org-wide default or an app actionOverride.
    -->
    <masterLabel>Utility Bill Record Page</masterLabel>
    <sobjectType>Utility_Bill__c</sobjectType>
    <template>
        <name>flexipage:recordHomeTemplateDesktop</name>
    </template>
    <type>RecordPage</type>
