                        <!-- 2026-08-27 — Underwriting__c.Advance_Stage (booleanFilter
                             '1 AND (2 OR 3)') is REMOVED, not amended. This repo has MEASURED that
                             a parenthesised OR deploys, survives a retrieve, and is then IGNORED BY
                             THE RENDERER (see NDA_Record_Page / LOI_Record_Page headers) — so the
                             old button very likely rendered at EVERY stage, including 'In Progress'
                             and the terminal 'Completed', not only at 'Requested'/'Approved' as
                             intended. Replaced by two pure-AND entries below, each keyed on one
                             exact stage: Move_to_In_Progress (Requested -> In Progress) and
                             Move_to_Completed (Approved -> Completed). 🔴 DO NOT recreate the OR
                             "to preserve current behaviour" — the current behaviour is itself the
                             bug this split fixes. No button exists for In Progress -> Approved, on
                             purpose: that hop is owned by the principal approval process:
                             Underwriting__c.Submit_for_Approval already renders at exactly
                             Stage__c = 'In Progress' and stays untouched. -->
                        <valueListItems>
                            <value>Underwriting__c.Move_to_In_Progress</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Acquisition_Deal_Actions}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Stage__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Requested</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Underwriting__c.Move_to_Completed</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!$Permission.CustomPermission.Acquisition_Deal_Actions}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Stage__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Approved</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <!-- 'Completed' is terminal — no button, per user decision #2. -->
                    </valueList>
