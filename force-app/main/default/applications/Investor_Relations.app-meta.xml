<?xml version="1.0" encoding="UTF-8"?>
<CustomApplication xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
        THIS NOTE LIVES IN A COMMENT, NOT IN <description>, AND IT MUST STAY THAT WAY.
        CustomApplication.Description is capped at 255 characters. The full rationale below
        is operationally important, so it was moved here rather than trimmed; a comment is
        repo-only and is never sent to the Metadata API, so it can be as long as it needs to
        be. Do not paste this back into <description>.

        DPEG Investor Relations is the IR-record-type Lead/Contact/Account population,
        segregated from Acquisitions. No actionOverrides: this task creates the app shell
        only, on standard object pages; a dedicated IR record page is a follow-up, not part
        of this task.

        =====================================================================
        Offering__c TAB ADDED 2026-08-16 - FSD Gap Tranche 1, Item 1, code-review Fix 1 (C1).
        =====================================================================
        OfferingService.ensureOnPsaExecuted (this same tranche) grants DPEG_IR_Edit / _View
        object and field access to Offering__c, and Offering__c.sharingRules-meta.xml grants
        record access, but neither gives IR a ROUTE to the record: this app declared only
        standard-Lead / standard-Contact / standard-Account / standard-report, and the only
        <tab>Offering__c</tab> grant anywhere in permissionsets/ was on DPEG_Admin_Access.
        Without this line an IR user with full object, field and record access still has
        nowhere to click to reach an Offering. Tab VISIBILITY is granted on the layer-2
        DPEG_App_Investor_Relations permission set, matching the other four tabs on this app -
        see that file's own comment.
    -->
    <brand>
        <headerColor>#0B5394</headerColor>
        <logo>DPEG_Logo_Clear</logo>
        <logoVersion>1</logoVersion>
        <shouldOverrideOrgTheme>true</shouldOverrideOrgTheme>
    </brand>
    <description>DPEG Investor Relations - IR-record-type Lead/Contact/Account population, segregated from Acquisitions. App shell only; dedicated IR record page is a follow-up.</description>
    <formFactors>Large</formFactors>
    <isNavAutoTempTabsDisabled>false</isNavAutoTempTabsDisabled>
    <isNavPersonalizationDisabled>false</isNavPersonalizationDisabled>
    <isNavTabPersistenceDisabled>false</isNavTabPersistenceDisabled>
    <isOmniPinnedViewEnabled>false</isOmniPinnedViewEnabled>
    <label>Investor Relations</label>
    <navType>Standard</navType>
    <tabs>standard-Lead</tabs>
    <tabs>standard-Contact</tabs>
    <tabs>standard-Account</tabs>
    <tabs>standard-report</tabs>
    <tabs>Offering__c</tabs>
    <uiType>Lightning</uiType>
</CustomApplication>
