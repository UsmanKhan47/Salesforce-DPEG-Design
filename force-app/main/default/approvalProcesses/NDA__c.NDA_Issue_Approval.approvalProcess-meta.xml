    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Disposition__c</field>
        <field>Counterparty_Name__c</field>
        <field>Party_Role__c</field>
        <field>Status__c</field>
        <field>OneDrive_URL__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>nikhil.dhanani@usmandpeg.uat</name>
                <type>user</type>
            </approver>
            <approver>
                <name>aftab.ali.dpeg.usman@avanzasolutions.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>junior.dhanani@usmandpeg.uat</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Principal approves NDA release</label>
        <name>Principal_Review_Step</name>
    </approvalStep>
    <description>Principal decision to approve a disposition NDA for release. Entry: Status is Prepare AND record type is Disposition NDA. Approval writes Status to Approved plus the Principal_Approved audit pair. No rejection action - record stays at Prepare.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2</booleanFilter>
        <criteriaItems>
            <field>NDA__c.Status__c</field>
            <operation>equals</operation>
            <value>Prepare</value>
        </criteriaItems>
        <criteriaItems>
            <field>NDA__c.Is_Disposition_NDA__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Set_NDA_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_NDA_Principal_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Set_NDA_Principal_Approved_Date</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>NDA Issue Approval</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
