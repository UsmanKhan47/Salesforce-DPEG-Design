    <description>Principal decision to approve this LOI. Entry: Stage equals Under Review AND Record Type equals Acquisition LOI (excludes Disposition_LOI, which shares the same Stage value). Approval sets LOI Status to Approved; a flow mirrors the decision onto the Opportunity. Rejection leaves the LOI at Under Review (D-3) — no deal-stage rewind, but now sets LOI Status to Rejected. Submission sets LOI Status to Pending Approval, hiding Submit for Approval; recall resets it to Draft.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>1 AND 2</booleanFilter>
        <criteriaItems>
            <field>LOI__c.Stage__c</field>
            <operation>equals</operation>
            <value>Under Review</value>
        </criteriaItems>
        <criteriaItems>
            <field>LOI__c.RecordType</field>
            <operation>equals</operation>
            <value>Acquisition LOI</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>LOI_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
