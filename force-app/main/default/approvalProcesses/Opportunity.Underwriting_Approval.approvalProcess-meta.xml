    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>StageName</field>
        <field>Asking_Price__c</field>
        <field>My_Price__c</field>
        <field>Underwritten_NOI__c</field>
        <field>My_Cap_Rate__c</field>
        <field>Underwriting_Notes__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>nikhil.dhanani@usmandpeg.uat</name>
                <type>user</type>
            </approver>
            <approver>
                <name>aftab.ali.dpeg.usman@avanzasolutions.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Principal Review</label>
        <name>Principal_Review_Step</name>
    </approvalStep>
    <description>Principal sign-off on a completed underwrite. EITHER principal (Ali or Nikhil) decides - first response wins: the first approval approves the deal and the first rejection rejects it; the second principal is never waited for and their work item is withdrawn. Approve: deal advances to LOI. Reject: deal stays at Underwriting with Underwriting Complete cleared, so the underwriter can rework the numbers and resubmit. Entry: deal is at the Underwriting stage. (Underwriting Complete / Section 12B is tracked on the deal but no longer gates submission.)</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Underwriting</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>UW_Set_Approved_Flag</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>UW_Set_Stage_Initiate_LOI</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>UW_Set_Status_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>UW_Reopen_For_Revision</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Underwriting Approval</label>
    <processOrder>2</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
