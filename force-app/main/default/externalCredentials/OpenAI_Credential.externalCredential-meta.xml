<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>Holds the OpenAI API key for LLMExtractionCalloutService. The key lives in the OpenAI_Principal authentication parameter, entered in Setup post-deploy and never serialized into metadata or source control.</description>
    <externalCredentialParameters>
        <parameterGroup>OpenAI_Principal</parameterGroup>
        <parameterName>OpenAI_Principal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>Authorization</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>Bearer {!$Credential.OpenAI_Credential.API_Key}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>OpenAI Credential</label>
</ExternalCredential>
