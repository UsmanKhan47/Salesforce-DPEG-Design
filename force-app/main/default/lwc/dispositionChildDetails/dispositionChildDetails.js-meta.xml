<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Disposition Child Details</masterLabel>
    <!--
        ⚠ THE description BELOW IS 228 CHARACTERS (counted, not estimated). The Metadata API caps
        it at 255 and ONLY A DEPLOY CATCHES A BREACH - Jest, the SLDS linter and code review have
        all passed a 258-character one in this repo. Count it before editing.
        ⚠ Keep this comment INSIDE the root element: a comment above the root breaks `sf` at
        source conversion with a misleading "unable to find matching parent xml file" error.
    -->
    <description>Shows one child record of a sale, its own fields, read only, on the Disposition record page. Pick the child object and list the fields; it resolves the latest child of that type and prints one honest line when the sale has none.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <!--
                🔴 RESTRICTED TO Disposition__c. Without this the card could be dropped on any
                record page, where the controller would refuse the foreign parent Id and the card
                would render a permanent error. The server-side guard in
                DispositionChildDetailsController is the other half; this is the half that stops
                the mistake being made at all.

                ⚠ THE ELEMENT FORM. The objects= ATTRIBUTE form is rejected by the Metadata API -
                measured in this repo on marketDataSync.js-meta.xml.
            -->
            <objects>
                <object>Disposition__c</object>
            </objects>
            <!--
                ⚠ NO recordId PROPERTY IS DECLARED, AND THAT IS DELIBERATE. recordId is a
                lightning__RecordPage IMPLICIT input: the JS `@api recordId` receives the real Id
                with no declaration on either side. The matching FlexiPage itemInstances therefore
                carry no recordId componentInstanceProperties block either - the shape proven on
                Disposition_Record_Page by bovBrokerChangeHistory and dispositionBuyerTimeline.
            -->
            <property
                name="childObject"
                type="String"
                label="Child Object"
                description="Which child of this sale to show. Only these two are supported by the controller."
                datasource="LOI__c,Contract_Review__c"/>
            <property
                name="fields"
                type="String"
                label="Fields"
                description="Comma separated field API names on the child object. Rendered read only, in the order given, two per row."/>
            <property
                name="cardTitle"
                type="String"
                label="Card Title"
                description="Heading on the card. Named cardTitle, not title, because title is a global HTML attribute."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
