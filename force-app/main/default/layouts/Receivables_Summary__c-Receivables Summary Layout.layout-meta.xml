<?xml version="1.0" encoding="UTF-8"?>
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
      EVERY layoutItem on this page is Readonly, deliberately and without exception. This object
      is a Yardi mirror overwritten in full on every nightly sync, so an edit here is not merely
      discouraged: it is silently discarded on the next run, which is strictly worse for the user
      than being refused outright. The permission model backs this up by granting no persona
      Create, Edit or Delete on the object at all (the Work_Order__c pattern, NOT the
      Delinquency__c pattern, which wrongly grants Edit on a read-only mirror).

      Yardi Last Synced sits in the FIRST section on purpose. FSD section 4 requires the
      last-synced timestamp to be visible on screen, and if the nightly job halts, this field is
      the only thing on the page telling the reader that the numbers below it are stale.
    -->
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Receivables Summary</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Name</field>
            </layoutItems>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Tenant_Name__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Property_Asset__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Unit__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Account__c</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Responsible_Property_Manager__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Monthly_Rent__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Yardi_Last_Synced_DateTime__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Sync_Run__c</field>
            </layoutItems>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>Yardi_AR_Id__c</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
