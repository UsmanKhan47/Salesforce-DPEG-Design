    </layoutSections>
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <label>System Information</label>
        <layoutColumns>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>CreatedById</field>
            </layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems>
                <behavior>Readonly</behavior>
                <field>LastModifiedById</field>
            </layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>false</detailHeading>
        <editHeading>true</editHeading>
        <layoutColumns/>
        <layoutColumns/>
        <layoutColumns/>
        <style>CustomLinks</style>
    </layoutSections>
    <!-- APPROVAL HISTORY, ADDED 2026-08-19 (code review C-3, child object half). BOV_Submission__c
         gained Broker_Finalize_Approval in this change, which sets allowRecall=true and
         recordEditability=AdminOnly, so a submitted BOV locks and Recall Approval Request exists
         ONLY on this list. This file previously had NO relatedLists block at all, so the same gap
         C-3 found on Disposition existed here too.
         UNLIKE Disposition, THIS OBJECT NEEDS NO SECOND FILE. There is no custom FlexiPage for
         BOV_Submission__c anywhere in force-app, so it renders on the org default record page,
         which is layout driven. Adding the list here is sufficient and is the only route.
         RelatedProcessHistoryList IS Approval History: the live describeLayout for Opportunity
         returns this list as name "ProcessSteps", label "Approval History". The five columns are
         the standard set copied from layouts/Opportunity-Opportunity Layout.layout-meta.xml. -->
    <relatedLists>
        <fields>CreatedDate</fields>
        <fields>StepStatus</fields>
        <fields>OriginalActor</fields>
        <fields>Actor</fields>
        <fields>Comments</fields>
        <relatedList>RelatedProcessHistoryList</relatedList>
    </relatedLists>
    <showEmailCheckbox>false</showEmailCheckbox>
    <showHighlightsPanel>false</showHighlightsPanel>
    <showInteractionLogPanel>false</showInteractionLogPanel>
    <showRunAssignmentRulesCheckbox>false</showRunAssignmentRulesCheckbox>
    <showSubmitAndAttachButton>false</showSubmitAndAttachButton>
</Layout>
