<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Acquisition App Access</label>
    <description>Makes the Acquisition, Disposition, and Transaction Lightning apps visible. Assign to non-admin full-license users (e.g. principals) who need to navigate those apps.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <applicationVisibilities>
        <application>Acquisition</application>
        <visible>true</visible>
    </applicationVisibilities>
    <applicationVisibilities>
        <application>Disposition</application>
        <visible>true</visible>
    </applicationVisibilities>
    <applicationVisibilities>
        <application>Transaction</application>
        <visible>true</visible>
    </applicationVisibilities>
</PermissionSet>
