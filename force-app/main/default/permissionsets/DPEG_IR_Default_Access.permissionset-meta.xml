        <field>Contact.Phone</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Contact.Referred_By__c</field>
        <readable>true</readable>
    </fieldPermissions>
