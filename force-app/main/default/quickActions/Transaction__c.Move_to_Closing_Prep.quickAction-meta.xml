<?xml version="1.0" encoding="UTF-8"?>
<QuickAction xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- THIS NOTE LIVES IN A COMMENT INSIDE THE ROOT ELEMENT - a comment placed ABOVE
         <QuickAction> breaks `sf` deploy at source conversion. See
         Transaction__c.Move_to_Due_Diligence.quickAction-meta.xml for the full rationale behind
         finishing this wave on Transaction__c (2026-08-28) and for why there is no
         <description>. Transaction__c carries no record types, so none of these four actions
         needs a record-type criterion.

         THE HOP: Transaction__c.Stage__c sequence is
         Open Contract -> Due Diligence -> Closing Prep -> Post-Closing -> Closed Won. This action
         serves Due Diligence -> Closing Prep, gated on Transaction_Record_Page by
         {!Record.Stage__c} EQUAL 'Due Diligence'. -->
    <actionSubtype>Action</actionSubtype>
    <label>Closing Prep</label>
    <lightningWebComponent>advanceRecordStage</lightningWebComponent>
    <optionsCreateFeedItem>false</optionsCreateFeedItem>
    <type>LightningWebComponent</type>
</QuickAction>
