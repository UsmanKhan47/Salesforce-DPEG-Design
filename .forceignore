# List files or directories below to ignore them when deploying/retrieving metadata
package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

# Local docs / design assets (not Salesforce metadata)
docs/

# CustomMetadata records: file-based deploy throws UNKNOWN_EXCEPTION in this org.
# Records are loaded via scripts/load-*-defs.apex (Apex Metadata API). Files kept as source-of-truth.
**/customMetadata/**

# --- Non-portable / non-deployable content (dryrun2-report.json, 2026-07-15 validation) ---

# Profiles are unportable across orgs and DPEG-Acq-5 has its own (this org lacks ~14 standard
# tabs the source profiles reference: TimeSheetEntry, DandBCompany, DelegatedAccount, PricebookEntry,
# QuickText, SocialPersona, InvoiceLine, ExpenseReportEntry, PrivacyJobSession, PrivacyRTBFRequest,
# ReportAnomalyEventStore, DevopsActivityLog, DevopsEnvironment, DevopsRequestInfo). Excluding profiles
# eliminates 394 errors (392 tab-visibility + 2 Guest-license userLicense errors on DPEG Broker Portal
# Profile / Guest License User). What the Admin profile granted is restored via the
# DPEG_Admin_Access permission set (tab visibility for every custom tab + FLS on the one field
# that only the Admin profile granted).
force-app/main/default/profiles/**

# Org Settings singletons are edition/feature-gated per-org config, not portable metadata.
# They belong in config/project-scratch-def.json (scratch org features), not a source deploy.
force-app/main/default/settings/**

# PRM report/dashboard folders whose sharedTo hardcodes a dead org's auto-generated guest username
# (test-3iuncy5c1je5@example.com), which does not exist in DPEG-Acq-5.
force-app/main/default/reports/prm_channel_reports_folder.reportFolder-meta.xml
force-app/main/default/dashboards/prm_channel_dashboard_folder.dashboardFolder-meta.xml

# Managed Content Types (cms_document, cms_image, news) are system-owned CMS types;
# the platform rejects updates to them via the Metadata API ("content type cannot be updated").
force-app/main/default/managedContentTypes/**

# FlowDefinitions carry stale activeVersionNumber values from the source org and fail with
# "Invalid version number". The paired Flow (.flow-meta.xml) files deploy and activate fine on
# their own without a FlowDefinition wrapper.
force-app/main/default/flowDefinitions/**

# Community QuickActions whose label ("New Community Case" / "Guest Community Case") is not a
# valid QuickActionLabel enum value in this org/API version.
force-app/main/default/quickActions/GuestCommunityCase.quickAction-meta.xml
force-app/main/default/quickActions/NewCommunityCase.quickAction-meta.xml

# --- Non-portable / non-deployable content (dryrun3-report.json, 2026-07-15 validation) ---

# Standard ListView on a system object; its own Name ("All CommSubscriptionChannelTypes") is
# auto-generated by the platform and exceeds the 40-char Name limit on validation in this org.
force-app/main/default/objects/CommSubscriptionChannelType/listViews/All_CommSubscriptionChannelTypes.listView-meta.xml

# Standard ListView on a system object; its filter value fails as a "bad value for restricted
# picklist" against this org's PaymentGroup schema.
force-app/main/default/objects/PaymentGroup/listViews/PaymentGroup.listView-meta.xml

# Standard Layout with an org-generated related list (WorkBadgeRelatedList) that references a
# "Recipient" field this org's edition/feature set doesn't expose - not ours to fix.
force-app/main/default/layouts/UserAlt-User Profile Layout.layout-meta.xml

# ProfileSessionSetting requires a <profile> reference, but Profiles are excluded from this
# deployment entirely (see the Profiles entry above) - this setting has nothing to attach to.
force-app/main/default/profileSessionSettings/Read_Only_profileSessionSetting1637020333761.profileSessionSetting-meta.xml

# Standard Einstein/Data.com CleanDataService definition; its field mapping API name fails this
# org's naming validation and is not something this project configures.
force-app/main/default/cleanDataServices/DataCloudGeoLocation.cleanDataService-meta.xml

# Standard "standard case" EntitlementProcess is already active/in-use in this org, so the
# platform rejects re-deploying an update to it ("Cannot update SLA process that is in use").
force-app/main/default/entitlementProcesses/standard case.entitlementProcess-meta.xml

# Standard AppMenu (AppSwitcher) fails validation with an opaque platform-side error
# (ErrorId 112646141-151147) unrelated to any change in this project.
force-app/main/default/appMenus/AppSwitcher.appMenu-meta.xml

# Standard org-wide NotificationTypeConfig carries a stale cross-reference id from the source
# org that doesn't resolve in DPEG-Acq-5.
force-app/main/default/notificationTypeConfig/NotificationTypeConfig.config-meta.xml
